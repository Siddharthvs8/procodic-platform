{
  "name": "procodic-platform",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @procodic/api --filter @procodic/web dev",
    "build": "pnpm --filter @procodic/db db:generate && pnpm --filter @procodic/api build && pnpm --filter @procodic/web build",
    "test": "pnpm --filter @procodic/api test",
    "db:generate": "pnpm --filter @procodic/db db:generate",
    "db:migrate": "pnpm --filter @procodic/db db:migrate",
    "db:deploy": "pnpm --filter @procodic/db db:deploy",
    "db:seed": "pnpm --filter @procodic/db db:seed"
  },
  "engines": { "node": ">=20.9" }
}
