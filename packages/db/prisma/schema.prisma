generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  PRODUCT
  PRODUCT_CATEGORY
  INDUSTRY
  RESEARCH_PROJECT
  TRAINING_PROGRAM
  CASE_STUDY
  TESTIMONIAL
  COLLABORATION
  TEAM_MEMBER
  ARTICLE
  FAQ
  NAVIGATION_ITEM
  HOMEPAGE_SECTION
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  SUPER_ADMIN
  ADMINISTRATOR
  CONTENT_MANAGER
  MARKETING_MANAGER
  SALES_MANAGER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  CONVERTED
  CLOSED
  NOT_INTERESTED
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(CONTENT_MANAGER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditLogs    AuditLog[]
  assignedLeads Lead[]   @relation("LeadAssignee")
}

model ContentItem {
  id              String        @id @default(cuid())
  type            ContentType
  title           String
  slug            String
  status          PublishStatus @default(DRAFT)
  featured        Boolean       @default(false)
  displayOrder    Int           @default(0)
  data            Json          @default("{}")
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([type, slug])
  @@index([type, status, displayOrder])
  @@index([updatedAt])
}

model Lead {
  id            String     @id @default(cuid())
  name          String
  email         String
  phone         String?
  company       String?
  designation   String?
  category      String
  productSlug   String?
  message       String
  status        LeadStatus @default(NEW)
  source        String     @default("website")
  assigneeId    String?
  assignee      AdminUser? @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  notes         LeadNote[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([email])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  content   String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  altText      String?
  category     String   @default("general")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime @default(now())
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
